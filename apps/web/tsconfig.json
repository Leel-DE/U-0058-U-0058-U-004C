{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@cr/db": ["../../packages/db/src"],
      "@cr/db/*": ["../../packages/db/src/*"],
      "@cr/shared": ["../../packages/shared/src"],
      "@cr/shared/*": ["../../packages/shared/src/*"]
    },
    "noEmit": true,
    "allowJs": false,
    "jsx": "preserve",
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "tests/e2e/**"]
}
