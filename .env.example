# Competitor Radar - local-first development defaults
# Copy manually only if needed. `pnpm setup:local` creates .env.local automatically.

NODE_ENV=development
LOCAL_DEV_MODE=true

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase CLI local stack
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=generated-by-pnpm-setup-local
SUPABASE_SERVICE_ROLE_KEY=generated-by-pnpm-setup-local
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Inngest dev server
INNGEST_EVENT_KEY=local_dev_event_key
INNGEST_SIGNING_KEY=signkey-local-dev

# Local scraper worker
WORKER_URL=http://localhost:4000
WORKER_HOST=127.0.0.1
WORKER_SHARED_SECRET=local-worker-secret-change-me
WORKER_BROWSER_MAX_PAGES=2

# External services disabled in local mode
RESEND_API_KEY=
RESEND_FROM_EMAIL=Competitor Radar Local <admin@demo.local>
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Seeded local admin
SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=DemoAdmin!2026
