# =============================================================================
# Competitor Radar — environment variables
# Copy this file to .env.local and fill values. NEVER commit .env.local.
# =============================================================================

# ----- Node ------------------------------------------------------------------
NODE_ENV=development

# ----- App URL (used in emails, OAuth redirects) -----------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- Supabase --------------------------------------------------------------
# Create a project at https://supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key # SERVER ONLY, never expose to client

# Postgres connection strings — Supabase → Settings → Database
# DATABASE_URL goes through PgBouncer (port 6543), used by app at runtime
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL is direct connection (port 5432), used for migrations
DIRECT_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ----- Inngest (background jobs) --------------------------------------------
# Local dev: install Inngest dev server (`npx inngest-cli@latest dev`) — keys can be dummy
# Prod: create account at https://www.inngest.com
INNGEST_EVENT_KEY=local_dev_event_key
INNGEST_SIGNING_KEY=signkey-local-dev

# ----- Scraper worker --------------------------------------------------------
WORKER_URL=http://localhost:4000
WORKER_SHARED_SECRET=change-me-to-a-long-random-string

# ----- TorqueCore shipment automation (optional, server-side only) ----------
# When configured, the Radar worker watches TorqueCore's durable shipment queue,
# performs headed Playwright checks sequentially, and stores results back there.
TORQUECORE_SUPABASE_URL=
TORQUECORE_SUPABASE_SERVICE_ROLE_KEY=
TORQUECORE_AUTOMATION_ORG_ID=
TORQUECORE_BRIDGE_POLL_MS=10000
TORQUECORE_OPENAI_API_KEY=
TORQUECORE_OPENAI_MODEL=gpt-5.4-mini
TORQUECORE_OPENAI_LANGUAGE=ru
TORQUECORE_TELEGRAM_BOT_TOKEN=
TORQUECORE_TELEGRAM_CHAT_ID=
TORQUECORE_TELEGRAM_SHIPMENTS_THREAD_ID=361
# The TorqueCore run queue must have exactly one consumer. When
# TORQUECORE_AUTOMATION_ORG_ID is set the Automation-Hub bridge owns the queue
# and the canonical monitor stays off. Set to true only to force the canonical
# monitor alongside the bridge (not recommended — duplicates every check).
TORQUECORE_CANONICAL_MONITOR=
TORQUECORE_SHIPMENT_QUEUE_POLL_MS=5000
TORQUECORE_SHIPMENT_SCHEDULE_SCAN_MS=60000
TORQUECORE_SHIPMENT_REFRESH_INTERVAL_MS=21600000
TORQUECORE_SHIPMENT_STALE_RUNNING_MS=1200000

# Shared local browser runtime. "adaptive" uses a minimized real Chrome on
# Windows and headless Chromium on Linux. Concurrency defaults to one to keep
# CPU/RAM usage predictable and avoid provider bursts.
AUTOMATION_BROWSER_MODE=adaptive
AUTOMATION_CHROME_PATH=
AUTOMATION_CONCURRENCY=1
AUTOMATION_QUEUE_POLL_MS=3000
AUTOMATION_PROFILE_DIR=

# Headed Chrome is the default because public tracking pages frequently block
# headless browsers. The window is started minimized and outside the desktop.
PLAYWRIGHT_HEADLESS=false

# Optional: path to a browser-storage snapshot (cookies + localStorage +
# sessionStorage) captured from your own Chrome via its remote debugging port.
# When set, the shipment worker replays this session into every tracking source
# context so consent walls, logins and anti-bot clearance cookies carry over.
# Capture it with:  pnpm capture:browser-storage
# The file holds real session secrets — keep it under .cache/ and never commit.
TORQUECORE_BROWSER_STORAGE_STATE_PATH=
# PLAYWRIGHT_PROXY_SERVER=http://127.0.0.1:8080
# PLAYWRIGHT_PROXY_USERNAME=
# PLAYWRIGHT_PROXY_PASSWORD=

# ----- AI-assisted scraping (optional, server-side only) ---------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
AI_EXTRACTION_MAX_HTML_CHARS=60000

# ----- Email (Resend) --------------------------------------------------------
# https://resend.com — for local dev you can leave empty, emails will be logged
RESEND_API_KEY=
RESEND_FROM_EMAIL=Competitor Radar <noreply@example.com>

# ----- Sentry (optional) -----------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ----- PostHog (optional) ----------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
