{
  "name": "competitor-radar",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/core": ">=2.8.0 <3",
      "@supabase/auth-js": ">=2.70.0 <3",
      "esbuild": ">=0.28.1 <0.29",
      "postcss": ">=8.5.10 <9",
      "protobufjs": ">=7.6.3 <8",
      "tmp": ">=0.2.6",
      "undici": ">=7.28.0 <8",
      "uuid": ">=11.1.1 <12"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "setup:local": "node scripts/setup-local.mjs",
    "dev": "concurrently -k -n web,worker,inngest -c blue,green,magenta \"pnpm dev:web\" \"pnpm dev:worker\" \"pnpm dev:inngest\"",
    "dev:web": "node scripts/run-with-local-env.mjs pnpm --filter @cr/web dev",
    "dev:worker": "node scripts/run-with-local-env.mjs pnpm --filter @cr/worker dev",
    "dev:inngest": "node scripts/run-with-local-env.mjs inngest-cli dev -u http://localhost:3000/api/inngest",
    "dev:desktop": "pnpm --filter @cr/desktop dev",
    "inngest:dev": "pnpm dev:inngest",
    "worker:dev": "pnpm dev:worker",
    "web:dev": "pnpm dev:web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @cr/web test:e2e",
    "supabase:start": "node scripts/supabase-local.mjs start",
    "supabase:stop": "node scripts/supabase-local.mjs stop",
    "db:reset": "node scripts/supabase-local.mjs db reset && pnpm db:push && pnpm db:seed",
    "db:studio": "node scripts/open-local-url.mjs http://localhost:54323",
    "db:generate": "pnpm --filter @cr/db generate",
    "db:push": "node scripts/run-with-local-env.mjs pnpm --filter @cr/db push",
    "db:migrate": "node scripts/run-with-local-env.mjs pnpm --filter @cr/db migrate",
    "db:verify": "node scripts/run-with-local-env.mjs pnpm --filter @cr/db verify",
    "db:seed": "node scripts/run-with-local-env.mjs pnpm --filter @cr/db seed",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,sql}\"",
    "clean": "turbo run clean && node -e \"require('node:fs').rmSync('node_modules',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "concurrently": "^9.2.1",
    "embedded-postgres": "18.3.0-beta.17",
    "inngest-cli": "^1.22.0",
    "pg": "^8.21.0",
    "postgres": "^3.4.5",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
