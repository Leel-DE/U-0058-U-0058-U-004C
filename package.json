{
  "name": "competitor-radar",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @cr/web test:e2e",
    "db:generate": "pnpm --filter @cr/db generate",
    "db:push": "pnpm --filter @cr/db push",
    "db:migrate": "pnpm --filter @cr/db migrate",
    "db:seed": "pnpm --filter @cr/db seed",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,sql}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
