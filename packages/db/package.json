{
  "name": "@cr/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "push": "tsx src/apply-drizzle-schema.ts && tsx src/apply-raw-sql.ts && tsx src/verify-schema.ts",
    "migrate": "tsx src/migrate.ts && tsx src/apply-raw-sql.ts && tsx src/verify-schema.ts",
    "sql:apply": "tsx src/apply-raw-sql.ts",
    "verify": "tsx src/verify-schema.ts",
    "studio": "drizzle-kit studio",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(no lint configured)\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
